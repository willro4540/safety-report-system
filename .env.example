# 이 파일을 복사해서 .env로 저장한 뒤 실제 값을 채워 넣으세요.
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다.

# 민원 접수 알림 메일 발신/수신 계정 (Gmail 기준, 앱 비밀번호 필요)
SEND_EMAIL=your_send_account@gmail.com
SEND_APP_PASSWORD=your_gmail_app_password
RECV_EMAIL=your_receive_account@gmail.com

# MySQL 연결 정보 (현재는 db/connection.py에서 로컬 JSON 모드로 폴백 중 — 향후 DB 완전 연동 시 사용)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=safety_report
